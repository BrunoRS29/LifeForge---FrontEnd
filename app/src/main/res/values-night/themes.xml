<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Variante NOTURNA do tema de janela: sem ela, a janela usava o tema claro
        também no modo escuro e o usuário via um "flash" branco na abertura do app
        antes de o Compose desenhar (diretriz Theme_Support do core app quality).
    -->
    <style name="Theme.LifeForge" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/lifeforge_window_background</item>
    </style>

    <style name="Theme.LifeForge.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/lifeforge_window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.LifeForge</item>
    </style>
</resources>
